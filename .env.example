db_host=
db_port=
db_user=
db_password=
db_name=

# Comma-separated list of tables whose DATA is skipped (schema is still dumped)
# Example: EXCLUDE_TABLES=public.some_cache,public.some_log
EXCLUDE_TABLES=

# Directory where the .sql dumps are written (created if missing)
# Defaults to ./dumps when left empty
DUMP_PATH=./dumps
