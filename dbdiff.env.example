# Config for db_diff.py. Copy to .dbdiffenv (git-ignored) and fill in.
# Usage: python db_diff.py .dbdiffenv [-o report.md]

# Source database (Railway)
RAILWAY_DB_HOST=
RAILWAY_DB_PORT=
RAILWAY_DB_USER=
RAILWAY_DB_PASSWORD=
RAILWAY_DB_NAME=
# Optional: disable | allow | prefer | require | verify-ca | verify-full
# Left empty = libpq default (prefer)
RAILWAY_DB_SSLMODE=

# Target database (AWS RDS)
RDS_DB_HOST=
RDS_DB_PORT=
RDS_DB_USER=
RDS_DB_PASSWORD=
RDS_DB_NAME=
RDS_DB_SSLMODE=
